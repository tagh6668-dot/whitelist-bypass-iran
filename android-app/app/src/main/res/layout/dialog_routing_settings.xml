<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <CheckBox
        android:id="@+id/routingEnableCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/routing_enable_label"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/routing_config_hint"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/routingConfigInput"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@android:drawable/editbox_background_normal"
        android:gravity="top|start"
        android:hint="{ ... }"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:typeface="monospace"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/routingResetButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/routing_reset_btn" />

        <Button
            android:id="@+id/routingValidateButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/routing_validate_btn" />

    </LinearLayout>

</LinearLayout>
