<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/cbLocalDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_pref_local_dns_enabled"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="12dp"
            android:text="@string/summary_pref_local_dns_enabled"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbFakeDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/title_pref_fake_dns_enabled"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginBottom="12dp"
            android:text="@string/summary_pref_fake_dns_enabled"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_pref_remote_dns"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRemoteDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://1.1.1.1/dns-query,https://dns.google/dns-query"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_pref_domestic_dns"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDomesticDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="223.5.5.5,119.29.29.29"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_pref_local_dns_port"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etLocalDnsPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="10853"
            android:inputType="number"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_pref_dns_hosts"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDnsHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="domain:address,…"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_pref_vpn_dns"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etVpnDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1.1.1.1,1.0.0.1"
            android:inputType="text"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
